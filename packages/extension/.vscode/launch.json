{
  // F5: build the extension + daemon, then open a new VS Code window with Nocap loaded.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Nocap extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "preLaunchTask": "Nocap: build"
    }
  ]
}
