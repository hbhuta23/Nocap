{
  "name": "nocap",
  "displayName": "nocap",
  "description": "Makes every AI coding agent prove what it's about to do before it does it.",
  "version": "0.0.1",
  "publisher": "nocap",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nocap",
          "title": "nocap",
          "icon": "media/nocap.svg"
        }
      ]
    },
    "views": {
      "nocap": [
        {
          "type": "webview",
          "id": "nocap.panel",
          "name": "nocap"
        }
      ]
    },
    "commands": [
      {
        "command": "nocap.enable",
        "title": "nocap: Enable in this workspace"
      },
      {
        "command": "nocap.disable",
        "title": "nocap: Disable in this workspace"
      },
      {
        "command": "nocap.setTask",
        "title": "nocap: Set task"
      },
      {
        "command": "nocap.openPanel",
        "title": "nocap: Open panel"
      },
      {
        "command": "nocap.relaunchTerminals",
        "title": "nocap: Relaunch terminals"
      },
      {
        "command": "nocap.menu",
        "title": "nocap",
        "icon": {
          "light": "media/logo.svg",
          "dark": "media/logo.svg"
        }
      },
      {
        "command": "nocap.addRule",
        "title": "nocap: Add a team rule",
        "icon": "$(add)"
      },
      {
        "command": "nocap.manageRules",
        "title": "nocap: Team rules",
        "icon": "$(law)"
      },
      {
        "command": "nocap.setApiKey",
        "title": "nocap: Set Gemini API key",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nocap.menu",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "nocap.addRule",
          "when": "view == nocap.panel",
          "group": "navigation"
        },
        {
          "command": "nocap.manageRules",
          "when": "view == nocap.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "nocap",
      "properties": {
        "nocap.autoProtect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Protect every workspace automatically: install hooks for the AI agents on this machine (Claude Code, VS Code chat, Cursor, Codex, Gemini CLI, Antigravity) and put the terminal shims on PATH. Turn off to enable nocap per workspace with **nocap: Enable in this workspace**."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@nocap/shared": "^0.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "icon": "media/icon.png"
}
