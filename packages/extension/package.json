{
  "name": "nocap",
  "displayName": "nocap: Stop AI agents from capping",
  "description": "Checks what your AI coding agent is about to do before it does it: dry-runs SQL, estimates LLM spend, catches weakened tests, enforces your team rules, and makes you say what you expect before you approve. Works with Claude Code, Cursor, Codex, Gemini, Antigravity, VS Code chat and any terminal agent.",
  "version": "0.1.0",
  "publisher": "hbhuta23",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hbhuta23/Polygraph"
  },
  "homepage": "https://github.com/hbhuta23/Polygraph#readme",
  "bugs": {
    "url": "https://github.com/hbhuta23/Polygraph/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "claude code",
    "cursor",
    "copilot",
    "codex",
    "gemini",
    "safety",
    "guardrails",
    "sql",
    "code review",
    "llm cost"
  ],
  "categories": [
    "AI",
    "Linters",
    "Other"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nocap",
          "title": "nocap",
          "icon": "media/nocap.svg"
        }
      ]
    },
    "views": {
      "nocap": [
        {
          "type": "webview",
          "id": "nocap.panel",
          "name": "nocap"
        }
      ]
    },
    "commands": [
      {
        "command": "nocap.enable",
        "title": "nocap: Enable in this workspace"
      },
      {
        "command": "nocap.disable",
        "title": "nocap: Disable in this workspace"
      },
      {
        "command": "nocap.setTask",
        "title": "nocap: Set task"
      },
      {
        "command": "nocap.openPanel",
        "title": "nocap: Open panel"
      },
      {
        "command": "nocap.relaunchTerminals",
        "title": "nocap: Relaunch terminals"
      },
      {
        "command": "nocap.menu",
        "title": "nocap",
        "icon": {
          "light": "media/logo.svg",
          "dark": "media/logo.svg"
        }
      },
      {
        "command": "nocap.addRule",
        "title": "nocap: Add a team rule",
        "icon": "$(add)"
      },
      {
        "command": "nocap.manageRules",
        "title": "nocap: Team rules",
        "icon": "$(law)"
      },
      {
        "command": "nocap.setApiKey",
        "title": "nocap: Set Gemini API key",
        "icon": "$(key)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nocap.menu",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "nocap.addRule",
          "when": "view == nocap.panel",
          "group": "navigation"
        },
        {
          "command": "nocap.manageRules",
          "when": "view == nocap.panel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "nocap",
      "properties": {
        "nocap.autoProtect": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Protect every workspace automatically: install hooks for the AI agents on this machine (Claude Code, VS Code chat, Cursor, Codex, Gemini CLI, Antigravity) and put the terminal shims on PATH. Turn off to enable nocap per workspace with **nocap: Enable in this workspace**."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "npm run build && vsce package --no-dependencies",
    "publish:marketplace": "npm run build && vsce publish --no-dependencies",
    "publish:openvsx": "npm run package && ovsx publish nocap-$npm_package_version.vsix"
  },
  "dependencies": {
    "@nocap/shared": "^0.0.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
