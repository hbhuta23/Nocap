#!/bin/bash
# Nocap universal shim (A4). Owner: Role A.
# Each wrapper in this folder runs: exec _nocap_shim <real-binary-name> "$@"
# The extension prepends this folder to PATH in VS Code terminals only (A8).

NAME="$1"; shift
SHIM_DIR="$(cd "$(dirname "$0")" && pwd)"
PORT="${NOCAP_PORT:-7777}"

# Find a binary on PATH, skipping our own folder (otherwise we'd call ourselves forever).
find_real() {
  local IFS=:
  for d in $PATH; do
    [ "$d" = "$SHIM_DIR" ] && continue
    [ -x "$d/$1" ] && { printf '%s' "$d/$1"; return 0; }
  done
  return 1
}

REAL="$(find_real "$NAME")" || { echo "Nocap: $NAME not found on PATH" >&2; exit 127; }

# Claude Code's PreToolUse hook already checked this command; don't check (or prompt) twice.
if [ -n "$CLAUDECODE" ]; then exec "$REAL" "$@"; fi

# Read-only git runs locally with no daemon round trip. Agents call git constantly in the background
# (Claude Code: ~100 calls in 90 s for its status line and change tracking, recorded in A0.2).
git_is_readonly() {
  while [ $# -gt 0 ]; do
    case "$1" in
      -c|-C|--git-dir|--work-tree|--namespace) shift 2 ;;
      -*) shift ;;
      *) break ;;
    esac
  done
  case "$1" in
    status|log|show|diff|diff-tree|diff-index|rev-parse|rev-list|symbolic-ref|ls-files|ls-tree|cat-file|for-each-ref|describe|blame|shortlog|merge-base|write-tree|commit-tree|update-index|hash-object|mktree) return 0 ;;
    remote) case "$2" in ""|-v|get-url|show) return 0 ;; esac ;;
    config) case " $* " in *" --get"*|*" --list "*|*" -l "*) return 0 ;; esac ;;
  esac
  return 1
}
if [ "$NAME" = git ] && git_is_readonly "$@"; then exec "$REAL" "$@"; fi

CURL="$(find_real curl)" || exec "$REAL" "$@"

CURL_ARGS=(-sS --fail --max-time 310
  --data-urlencode "bin=$NAME"
  --data-urlencode "cwd=$PWD"
  --data-urlencode "intent=${NOCAP_INTENT:-}"
  --data-urlencode "session=${NOCAP_SESSION:-term-$PPID}")
for a in "$@"; do CURL_ARGS+=(--data-urlencode "arg=$a"); done

RESP="$("$CURL" "${CURL_ARGS[@]}" "http://127.0.0.1:$PORT/v1/shim" 2>/dev/null)"
if [ $? -ne 0 ]; then
  # FR-G4: daemon offline. Safe commands pass, risky ones are blocked.
  if printf '%s ' "$NAME" "$@" | grep -Eiq 'rm -[a-z]*[rf]|DELETE FROM|DROP (TABLE|DATABASE)|TRUNCATE|reset --hard|clean -[a-z]*f|push (-f|--force)'; then
    echo "Nocap is offline, so risky commands are blocked." >&2
    exit 86
  fi
  exec "$REAL" "$@"
fi

VERDICT="$(printf '%s\n' "$RESP" | head -n 1)"
REASON="$(printf '%s\n' "$RESP" | tail -n +2)"

case "$VERDICT" in
  allow) exec "$REAL" "$@" ;;
  warn) [ -n "$REASON" ] && echo "$REASON" >&2; exec "$REAL" "$@" ;;
  *) echo "$REASON" >&2; exit 86 ;;
esac
